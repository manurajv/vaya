rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSupplier() {
      return isAuth() && callerDoc().userType == 'supplier';
    }

    function isBuyer() {
      return isAuth() && callerDoc().userType == 'buyer';
    }

    function isOwner(userId) {
      return isAuth() && uid() == userId;
    }

    function isGroupMember(groupData) {
      // Use flat memberIds array for O(1) lookup
      return groupData.memberIds.hasAny([uid()]);
    }

    function isGroupSupplier(groupData) {
      return isAuth() && groupData.supplierId == uid();
    }

    function isGroupCreator(groupData) {
      return isAuth() && groupData.creatorId == uid();
    }

    // Returns true if the update only touches the listed fields
    function onlyChanging(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(fields);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();

      allow create: if isOwner(userId)
        && request.resource.data.userType in ['buyer', 'supplier']
        && request.resource.data.phoneNumber is string
        && request.resource.data.businessName is string;

      allow update: if isOwner(userId)
        // Prevent userType escalation
        && request.resource.data.userType == resource.data.userType
        // isVerifiedSupplier can only be set by Cloud Functions / admin
        && request.resource.data.isVerifiedSupplier == resource.data.isVerifiedSupplier;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PRODUCTS
    // ─────────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isAuth();

      allow create: if isSupplier()
        && request.resource.data.supplierId == uid()
        && request.resource.data.name is string
        && request.resource.data.pricingTiers is list
        && request.resource.data.pricingTiers.size() > 0
        && request.resource.data.minimumOrderQuantity is int
        && request.resource.data.minimumOrderQuantity > 0;

      allow update: if isSupplier()
        && resource.data.supplierId == uid()
        && request.resource.data.supplierId == resource.data.supplierId;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && (
          // Buyer creating a buyer-initiated group
          (isBuyer()
            && request.resource.data.mode == 'buyer_initiated'
            && request.resource.data.creatorId == uid())
          ||
          // Supplier creating a supplier-target group for their own product
          (isSupplier()
            && request.resource.data.mode == 'supplier_target'
            && request.resource.data.supplierId == uid()
            && request.resource.data.creatorId == uid()
            && request.resource.data.discountApproved == true)
        )
        && request.resource.data.minimumQuantity is int
        && request.resource.data.minimumQuantity > 0
        && request.resource.data.pricingTiers is list
        && request.resource.data.pricingTiers.size() > 0;

      allow update: if isAuth() && (
        // ① Any authenticated buyer can join (adds themselves to members/memberIds)
        //   or increase their quantity — both touch members, memberIds, totalQuantity
        (isBuyer() && onlyChanging([
          'members', 'memberIds', 'totalQuantity', 'status', 'updatedAt'
        ]))
        ||
        // ② Group creator can extend deadline, request approval, invite
        isGroupCreator(resource.data)
        ||
        // ③ Supplier can approve/reject discount, update status
        isGroupSupplier(resource.data)
      );

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ORDERS
    // ─────────────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == uid() ||
        resource.data.supplierId == uid()
      );

      // Orders created by Cloud Functions; allow buyer fallback
      allow create: if isAuth()
        && request.resource.data.buyerId == uid();

      // Buyer updates payment status only
      // Supplier updates order status + tracking only
      allow update: if isAuth() && (
        (resource.data.buyerId == uid()
          && onlyChanging(['paymentStatus', 'updatedAt']))
        ||
        (resource.data.supplierId == uid()
          && onlyChanging(['status', 'trackingNumber', 'trackingUrl',
                           'estimatedDelivery', 'deliveredAt',
                           'supplierNotes', 'updatedAt']))
      );

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PAYMENTS (proof uploads)
    // ─────────────────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        resource.data.supplierId == uid()
      );

      allow create: if isAuth()
        && request.resource.data.userId == uid()
        && request.resource.data.paymentType in ['token', 'final'];

      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CHAT MESSAGES
    // ─────────────────────────────────────────────────────────────────────────
    match /chats/{groupId}/messages/{messageId} {
      allow read: if isAuth() && (
        isGroupMemberByIdFlat(groupId) || isGroupSupplierById(groupId)
      );

      allow create: if isAuth()
        && (isGroupMemberByIdFlat(groupId) || isGroupSupplierById(groupId))
        && request.resource.data.senderId == uid()
        && request.resource.data.type in
           ['text', 'image', 'video', 'audio', 'file', 'system'];

      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == uid();

      // Users can only mark their own notifications as read
      allow update: if isAuth()
        && resource.data.userId == uid()
        && onlyChanging(['isRead']);

      allow create, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // INVOICES
    // ─────────────────────────────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.buyerId == uid() ||
        resource.data.supplierId == uid()
      );
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS (require document lookups)
    // ─────────────────────────────────────────────────────────────────────────

    // Uses flat memberIds array — faster and avoids object comparison issues
    function isGroupMemberByIdFlat(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return g.memberIds.hasAny([uid()]);
    }

    function isGroupSupplierById(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return g.supplierId == uid();
    }
  }
}
