rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Fetch the caller's user document (cached per request)
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSupplier() {
      return isAuth() && callerDoc().userType == 'supplier';
    }

    function isBuyer() {
      return isAuth() && callerDoc().userType == 'buyer';
    }

    function isOwner(userId) {
      return isAuth() && uid() == userId;
    }

    // Check if the caller is a member of a group
    function isGroupMember(groupData) {
      return groupData.members.hasAny([{'userId': uid()}]);
    }

    // Check if the caller is the supplier of a group
    function isGroupSupplier(groupData) {
      return isAuth() && groupData.supplierId == uid();
    }

    // Check if the caller is the creator of a group
    function isGroupCreator(groupData) {
      return isAuth() && groupData.creatorId == uid();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read basic profile info
      // (needed for group member display, supplier name lookup)
      allow read: if isAuth();

      // Only the owner can create or update their own profile
      allow create: if isOwner(userId)
        && request.resource.data.userType in ['buyer', 'supplier']
        && request.resource.data.phoneNumber is string
        && request.resource.data.businessName is string;

      allow update: if isOwner(userId)
        // Prevent userType escalation after creation
        && request.resource.data.userType == resource.data.userType
        // Prevent self-verification (isVerifiedSupplier set by admin/functions only)
        && request.resource.data.isVerifiedSupplier == resource.data.isVerifiedSupplier;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PRODUCTS
    // ─────────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      // All authenticated users can browse products
      allow read: if isAuth();

      // Only the owning supplier can create a product
      allow create: if isSupplier()
        && request.resource.data.supplierId == uid()
        && request.resource.data.name is string
        && request.resource.data.pricingTiers is list
        && request.resource.data.pricingTiers.size() > 0
        && request.resource.data.minimumOrderQuantity is int
        && request.resource.data.minimumOrderQuantity > 0;

      // Only the owning supplier can update their product
      allow update: if isSupplier()
        && resource.data.supplierId == uid()
        // Supplier cannot change the supplierId
        && request.resource.data.supplierId == resource.data.supplierId;

      // Soft-delete only (set isActive = false); hard delete not allowed
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      // Any authenticated user can read groups (needed for browsing deals)
      allow read: if isAuth();

      // Buyers can create buyer-initiated groups
      // Suppliers can create supplier-target groups for their own products
      allow create: if isAuth()
        && (
          // Buyer creating a buyer-initiated group
          (isBuyer()
            && request.resource.data.mode == 'buyer_initiated'
            && request.resource.data.creatorId == uid())
          ||
          // Supplier creating a target group for their own product
          (isSupplier()
            && request.resource.data.mode == 'supplier_target'
            && request.resource.data.supplierId == uid()
            && request.resource.data.creatorId == uid()
            && request.resource.data.discountApproved == true)
        )
        && request.resource.data.minimumQuantity is int
        && request.resource.data.minimumQuantity > 0
        && request.resource.data.pricingTiers is list
        && request.resource.data.pricingTiers.size() > 0;

      allow update: if isAuth() && (
        // Any authenticated user can join (add themselves to members)
        // or update totalQuantity — validated by Cloud Function / transaction
        isGroupMember(resource.data)
        ||
        // Group creator can update (invite, extend deadline)
        isGroupCreator(resource.data)
        ||
        // Supplier can approve/reject discount and update order status
        isGroupSupplier(resource.data)
      );

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ORDERS
    // ─────────────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Buyer can read their own orders; supplier can read orders for their products
      allow read: if isAuth() && (
        resource.data.buyerId == uid() ||
        resource.data.supplierId == uid()
      );

      // Orders are created by Cloud Functions (onGroupCompleted trigger)
      // Allow buyers to create directly as fallback
      allow create: if isAuth()
        && request.resource.data.buyerId == uid();

      // Buyer can update payment status on their own orders
      // Supplier can update order status (confirmed/shipped/delivered)
      allow update: if isAuth() && (
        (resource.data.buyerId == uid()
          && onlyChanging(['paymentStatus', 'updatedAt']))
        ||
        (resource.data.supplierId == uid()
          && onlyChanging(['status', 'trackingNumber', 'trackingUrl',
                           'estimatedDelivery', 'deliveredAt',
                           'supplierNotes', 'updatedAt']))
      );

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PAYMENTS (proof uploads)
    // ─────────────────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Buyer can read their own payment records
      // Supplier can read payment records for their groups
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        resource.data.supplierId == uid()
      );

      // Buyers upload payment proofs
      allow create: if isAuth()
        && request.resource.data.userId == uid()
        && request.resource.data.paymentType in ['token', 'final'];

      // Status updates done by Cloud Functions / admin only
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CHAT MESSAGES
    // ─────────────────────────────────────────────────────────────────────────
    match /chats/{groupId}/messages/{messageId} {
      // Only group members and the group's supplier can read/write chat
      allow read: if isAuth() && (
        isGroupMemberById(groupId) || isGroupSupplierById(groupId)
      );

      allow create: if isAuth()
        && (isGroupMemberById(groupId) || isGroupSupplierById(groupId))
        && request.resource.data.senderId == uid()
        && request.resource.data.type in
           ['text', 'image', 'video', 'audio', 'file', 'system'];

      // Messages are immutable once sent
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuth() && resource.data.userId == uid();

      // Users can mark their own notifications as read
      allow update: if isAuth()
        && resource.data.userId == uid()
        && onlyChanging(['isRead']);

      // Created and deleted by Cloud Functions only
      allow create, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // INVOICES
    // ─────────────────────────────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.buyerId == uid() ||
        resource.data.supplierId == uid()
      );
      // Created by Cloud Functions only
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS (require document lookups)
    // ─────────────────────────────────────────────────────────────────────────

    function isGroupMemberById(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return g.members.hasAny([{'userId': uid()}]);
    }

    function isGroupSupplierById(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return g.supplierId == uid();
    }

    // Returns true if the update only touches the listed fields
    function onlyChanging(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(fields);
    }
  }
}
