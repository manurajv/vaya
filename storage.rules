rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isMediaOrDoc() {
      return isImage() || isVideo() || isAudio()
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/.*');
    }

    function maxSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function isSupplier() {
      return firestore.get(/databases/(default)/documents/users/$(uid())).data.userType == 'supplier';
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PROFILE IMAGES  /profile_images/{userId}/filename
    // ─────────────────────────────────────────────────────────────────────────
    match /profile_images/{userId}/{fileName} {
      // Any authenticated user can view profile images
      allow read: if isAuth();

      // Only the owner can upload their own profile image
      allow write: if isAuth()
        && uid() == userId
        && isImage()
        && maxSize(5);  // 5 MB max
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PRODUCT IMAGES  /product_images/{supplierId}/{fileName}
    // ─────────────────────────────────────────────────────────────────────────
    match /product_images/{supplierId}/{fileName} {
      // All authenticated users can view product images
      allow read: if isAuth();

      // Only the owning supplier can upload product images
      allow write: if isAuth()
        && uid() == supplierId
        && isSupplier()
        && isImage()
        && maxSize(10);  // 10 MB max
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CHAT MEDIA  /chat_media/{groupId}/{fileName}
    // ─────────────────────────────────────────────────────────────────────────
    match /chat_media/{groupId}/{fileName} {
      // Any authenticated user can read chat media
      // (group membership enforced at Firestore level)
      allow read: if isAuth();

      // Any authenticated user can upload chat media
      allow write: if isAuth()
        && isMediaOrDoc()
        && maxSize(50);  // 50 MB max
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PAYMENT PROOFS  /payment_proofs/{userId}/{fileName}
    // ─────────────────────────────────────────────────────────────────────────
    match /payment_proofs/{userId}/{fileName} {
      // Owner and suppliers can read payment proofs
      allow read: if isAuth() && (
        uid() == userId || isSupplier()
      );

      // Only the owner (buyer) can upload their payment proof
      allow write: if isAuth()
        && uid() == userId
        && isImage()
        && maxSize(10);  // 10 MB max
    }

    // ─────────────────────────────────────────────────────────────────────────
    // INVOICES  /invoices/{orderId}/{fileName}
    // ─────────────────────────────────────────────────────────────────────────
    match /invoices/{orderId}/{fileName} {
      // Buyer and supplier of the order can read invoices
      allow read: if isAuth();

      // Invoices are generated by Cloud Functions only
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SUPPLIER DOCUMENTS  /supplier_docs/{supplierId}/{fileName}
    // (KYC, GST certificates, etc. — future use)
    // ─────────────────────────────────────────────────────────────────────────
    match /supplier_docs/{supplierId}/{fileName} {
      // Only the owning supplier can read their own docs
      allow read: if isAuth() && uid() == supplierId;

      // Supplier can upload their own verification documents
      allow write: if isAuth()
        && uid() == supplierId
        && isSupplier()
        && maxSize(20);  // 20 MB max
    }
  }
}
